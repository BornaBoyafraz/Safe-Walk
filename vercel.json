{
  "buildCommand": "node scripts/export-heatmap.js || true",
  "installCommand": "npm install",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/demo", "destination": "/public/index.html" },
    { "source": "/demo/:path*", "destination": "/public/:path*" },
    { "source": "/js/:path*", "destination": "/public/js/:path*" },
    { "source": "/how-it-works", "destination": "/website/how-it-works.html" },
    { "source": "/about", "destination": "/website/about.html" },
    { "source": "/partners", "destination": "/website/partners.html" },
    { "source": "/", "destination": "/website/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
