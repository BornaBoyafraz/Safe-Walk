# Single API key used for both client (Maps JS, Places) and server (Routes API).
# Current one-key demo setup: Application Restrictions must be "None" because
# the Node/Vercel route API also calls Google Routes with this key.
# API Restrictions: Maps JavaScript API, Places API, Routes API.
#
# Production hardening later: split this into a browser key with HTTP referrer
# restrictions and a server key for Routes API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_key_here

# Optional later hardening: set this to a separate server key for Routes API.
# If omitted, the backend route API falls back to NEXT_PUBLIC_GOOGLE_MAPS_API_KEY.
# GOOGLE_MAPS_API_KEY=your_server_routes_key_here

# Server
PORT=3000
