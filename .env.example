# Browser key, visible to the Next.js client. Restrict this key by HTTP referrer.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_browser_key_here

# Server key, used by Express/Vercel functions for Google Routes API calls.
# Keep this separate from the browser key.
GOOGLE_MAPS_API_KEY=your_server_routes_key_here

# Optional: use when running the Next.js client against a separate API origin.
# In local development, next.config.ts proxies /api/* to http://127.0.0.1:3000.
# NEXT_PUBLIC_API_BASE=http://localhost:3000

# Server
PORT=3000
